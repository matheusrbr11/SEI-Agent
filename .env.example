# Copie para .env e preencha. Nunca compartilhe nem versione o .env.
# A senha do SEI não fica aqui: o agente a pergunta a cada execução.
SEI_USUARIO=<seu usuário do SEI>
SEI_ORGAO=<seu órgão do SEI>
SEI_UNIDADE=<sua unidade do SEI>

# marcador | novos
SEI_MODO=marcador
SEI_MARCADOR=AGENTE - ANALISAR

# Documentos do SEI com menos caracteres que isso são baixados e lidos pelo anexo
LIMITE_TEXTO_DOCUMENTO=80
HEADLESS=False

# Pasta "entrada" do SharePoint sincronizada pelo OneDrive (vazio = não copia)
SHAREPOINT_PASTA_ENTRADA=<caminho da pasta de entrada do SharePoint, sincronizada pelo OneDrive>

# Pasta "saida" (análises do Power Automate) sincronizada pelo OneDrive; só é lida (vazio = não lê)
SHAREPOINT_PASTA_SAIDA=<caminho da pasta de saída do SharePoint, sincronizada pelo OneDrive>

# Depois de entregar os JSONs: quanto esperar, no total, pelas análises do Power Automate e de quanto em quanto tempo olhar a pasta de saída
SAIDA_ESPERA_MINUTOS=5
SAIDA_INTERVALO_SEGUNDOS=20

# Teams: webhook que recebe a análise corrigida e e-mails (separados por vírgula) de quem a recebe.
# Sem webhook ou sem destinatário, nada é enviado.
TEAMS_WEBHOOK_URL=
TEAMS_DESTINATARIOS=<e-mail de quem recebe a análise>
TEAMS_LIMITE_CARACTERES=25000

# Quantas vezes seguidas um processo pode falhar (coleta ou entrega) antes de o agente parar de tentá-lo sozinho.
TENTATIVAS_MAXIMAS=3
